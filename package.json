{
  "name": "careersetu-backend",
  "version": "1.0.0",
  "description": "CareerSetu Backend API — Node.js, Express, MongoDB Atlas",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test:health": "node backend/scripts/testHealth.js",
