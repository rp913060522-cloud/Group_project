# CareerSetu — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get this from your Atlas cluster → Connect → Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/careersetu?retryWrites=true&w=majority

# ── DNS Configuration (Optional) ──────────────────────────────────────────────
# Public DNS servers if default ISP resolver fails SRV queries (ECONNREFUSED)
DNS_SERVERS=8.8.8.8,1.1.1.1,8.8.4.4
MONGODB_TIMEOUT_MS=25000

# ── JWT (Phase 2) ─────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# ── Groq API (Phase 4 — AI Career Guidance) ──────────────────────────────────
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# ── Admin credentials (Phase 5) ───────────────────────────────────────────────
# Used by "npm run setup:admin" to provision the first administrator account
ADMIN_EMAIL=admin@careersetu.org
ADMIN_PASSWORD=replace-with-secure-admin-password
ADMIN_NAME=CareerSetu Administrator

# ── Transactional Email (Password Reset) ──────────────────────────────────────
# Option A: Brevo HTTP API (Recommended for Render Free Tier — delivers over HTTPS Port 443)
# Free tier: 300 emails/day forever. Sign up at https://brevo.com -> API Keys
BREVO_API_KEY=your-brevo-api-key-here

# Option B: Resend HTTP API (Alternative for cloud platforms — delivers over HTTPS Port 443)
# Free tier: 3,000 emails/month. Sign up at https://resend.com -> API Keys
# RESEND_API_KEY=re_your_resend_api_key_here

# Option C: Standard SMTP (Localhost / Paid Cloud / VPS)
# Render Free Tier blocks outbound SMTP ports 25, 465, and 587. Use Option A or B on Render Free Tier.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM="CareerSetu Support" <your-email@gmail.com>
CLIENT_URL=http://localhost:5000
